{
  "version": 2,
  "name": "kasmi-domain-news",
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "js/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "components/**",
      "use": "@vercel/static"
    },
    {
      "src": "services/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    },
    {
      "src": "blog/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/$", "dest": "/landing.html" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/domain/(.*)", "dest": "/domain.html?domain=$1" },
    { "src": "/geo-domains", "dest": "/geo-domains.html" },
    { "src": "/keyword-domains", "dest": "/keyword-domains.html" },
    { "src": "/pattern-domains", "dest": "/pattern-domains.html" },
    { "src": "/brandable-domains", "dest": "/brandable-domains.html" },
    { "src": "/numeric-domains", "dest": "/numeric-domains.html" },
    { "src": "/domain-suggestor", "dest": "/domain-suggestor.html" },
    { "src": "/wordlist-combiner", "dest": "/wordlist-combiner.html" },
    { "src": "/smart-analyzer", "dest": "/smart-analyzer.html" },
    { "src": "/smart-email", "dest": "/smart-email.html" },
    { "src": "/bulk-checker", "dest": "/bulk-checker.html" },
    { "src": "/domain-extractor", "dest": "/domain-extractor.html" },
    { "src": "/text-tools", "dest": "/text-tools.html" },
    { "src": "/email-extractor", "dest": "/email-extractor.html" },
    { "src": "/domain-news", "dest": "/domain-news.html" },
    { "src": "/blog/category/(.*)", "dest": "/blog/category/$1/index.html" },
    { "src": "/blog/(.+)/$", "dest": "/blog/$1/index.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
