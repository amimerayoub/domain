{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/",                        "destination": "/landing.html" },
    { "source": "/index",                   "destination": "/landing.html" },
    { "source": "/index.html",              "destination": "/landing.html" },
    { "source": "/app",                     "destination": "/index.html" },
    { "source": "/api/:path*",             "destination": "/api/:path*.js" },
    { "source": "/domain/:domain",          "destination": "/domain.html" },
    { "source": "/geo-domains",             "destination": "/geo-domains.html" },
    { "source": "/keyword-domains",         "destination": "/keyword-domains.html" },
    { "source": "/pattern-domains",         "destination": "/pattern-domains.html" },
    { "source": "/brandable-domains",       "destination": "/brandable-domains.html" },
    { "source": "/numeric-domains",         "destination": "/numeric-domains.html" },
    { "source": "/domain-suggestor",        "destination": "/domain-suggestor.html" },
    { "source": "/wordlist-combiner",       "destination": "/wordlist-combiner.html" },
    { "source": "/smart-analyzer",          "destination": "/smart-analyzer.html" },
    { "source": "/smart-email",             "destination": "/smart-email.html" },
    { "source": "/bulk-checker",            "destination": "/bulk-checker.html" },
    { "source": "/domain-extractor",        "destination": "/domain-extractor.html" },
    { "source": "/text-tools",              "destination": "/text-tools.html" },
    { "source": "/email-extractor",         "destination": "/email-extractor.html" },
    { "source": "/domain-news",             "destination": "/domain-news.html" },
    { "source": "/about",                   "destination": "/about.html" },
    { "source": "/blog",                    "destination": "/blog.html" },
    { "source": "/contact",                 "destination": "/contact.html" },
    { "source": "/privacy",                 "destination": "/privacy.html" },
    { "source": "/security",                "destination": "/security.html" },
    { "source": "/terms",                   "destination": "/terms.html" },
    { "source": "/blog/category/:slug",     "destination": "/blog/category/:slug/index.html" },
    { "source": "/blog/:slug",              "destination": "/blog/:slug/index.html" }
  ]
}

